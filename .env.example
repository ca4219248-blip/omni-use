# Copy this file to `.env` and fill in your values.
# OmniUse reads plain environment variables, so `export` also works.

# --- LLM (any OpenAI-compatible provider) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OMNIUSE_MODEL=gpt-4o-mini

# Examples:
#   Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1  OMNIUSE_MODEL=llama-3.3-70b-versatile
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1       OMNIUSE_MODEL=qwen2.5:7b

# --- Agent behaviour ---
OMNIUSE_MAX_STEPS=30
OMNIUSE_HEADLESS=1              # 0 = watch the browser work
OMNIUSE_SCREENSHOTS_DIR=screenshots
OMNIUSE_WORKDIR=.               # cwd for system_run
OMNIUSE_DATA_DIR=data           # policies, memory, permissions, missions, payment queue
OMNIUSE_PLUGINS_DIR=plugins     # drop-in plugin toolsets (plugin.json + main.py)
# Persistent browser profile — logins/cookies survive restarts (leave empty for a fresh browser each run)
OMNIUSE_PROFILE_DIR=

# --- Speed: cheap/fast model for routine steps (defaults to OMNIUSE_MODEL) ---
# e.g. a Groq-hosted llama for routine turns, keep OMNIUSE_MODEL for planning/vision:
# OMNIUSE_FAST_MODEL=llama-3.3-70b-versatile
OMNIUSE_FAST_MODEL=

# --- Safety: optional system_run allowlist (fnmatch patterns, empty = unrestricted) ---
# A command runs only if it (or its first word) matches a pattern. Poor man's Docker:
# OMNIUSE_SYSTEM_ALLOWLIST=ls*,cat*,grep*,git status,git diff*,python*,pytest*
OMNIUSE_SYSTEM_ALLOWLIST=

# --- Autonomy brakes (daily caps; "0" = unlimited) ---
OMNIUSE_DAILY_STEPS=500
OMNIUSE_DAILY_TOOL_CALLS=500

# --- Operator control (terminal + voice, no external services) ---
# Secret token ONLY the human operator knows — needed to raise the spend limit
OMNIUSE_OPERATOR_TOKEN=
# Speech-to-text model for `python -m omniuse.voice` (any OpenAI-compatible endpoint)
OMNIUSE_STT_MODEL=whisper-1
# Text-to-speech for the voice_speak tool
OMNIUSE_TTS_MODEL=tts-1
OMNIUSE_TTS_VOICE=alloy

# --- Wallet (all optional; payments are only queued unless SEND_CMD is set) ---
OMNIUSE_RPC_URL=https://cloudflare-eth.com
OMNIUSE_WALLET_ADDRESS=         # your 0x… address (read-only balance checks)
OMNIUSE_WALLET_CURRENCY=ETH
OMNIUSE_WALLET_MAX_TX=0.01      # HARD per-transaction cap
OMNIUSE_AUTOPAY_MIN=            # balance threshold before any payment may go out
# Command that actually signs/sends (e.g. your hardware-wallet CLI). Called as:
#   <cmd> <to> <amount> <purpose>
# OmniUse NEVER touches private keys itself. Leave empty to queue payments only.
OMNIUSE_SEND_CMD=

# --- Remote body (Hub) ---
# On the device you want to control:  OMNIUSE_HUB_TOKEN=<secret> python -m omniuse.hub
# On the AI side:                      OMNIUSE_HUB_URL=http://<device>:8787  + same token
# (or register named hubs: `python -m omniuse.remote add pc1 <url> <token>`)
OMNIUSE_HUB_URL=
OMNIUSE_HUB_TOKEN=

# --- Design shop (UPI payments) ---
OMNIUSE_UPI_VPA=                # your UPI ID, e.g. yourname@okhdfcbank
OMNIUSE_PAYEE_NAME=             # name shown on payment requests and watermarks
# Optional: image model if your provider offers one (for design_ai_image)
OMNIUSE_IMAGE_MODEL=gpt-image-1
