# Copy this file to `.env` and fill in your values.
# OmniUse reads plain environment variables, so `export` also works.

# --- LLM (any OpenAI-compatible provider) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OMNIUSE_MODEL=gpt-4o-mini

# Examples:
#   Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1  OMNIUSE_MODEL=llama-3.3-70b-versatile
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1       OMNIUSE_MODEL=qwen2.5:7b

# --- Agent behaviour ---
OMNIUSE_MAX_STEPS=30
OMNIUSE_HEADLESS=1              # 0 = watch the browser work
OMNIUSE_SCREENSHOTS_DIR=screenshots
OMNIUSE_WORKDIR=.               # cwd for system_run
OMNIUSE_DATA_DIR=data           # policies, memory, permissions, missions, payment queue
OMNIUSE_PLUGINS_DIR=plugins     # drop-in plugin toolsets (plugin.json + main.py)

# --- Operator control ---
# Telegram bot for escalation alerts + /stop /resume /resolve /approve (from @BotFather,
# then message the bot once and check https://api.telegram.org/bot<TOKEN>/getUpdates for your chat id)
OMNIUSE_TELEGRAM_BOT_TOKEN=
OMNIUSE_TELEGRAM_CHAT_ID=
# Secret token ONLY the human operator knows — needed to raise the spend limit
OMNIUSE_OPERATOR_TOKEN=

# --- Wallet (all optional; payments are only queued unless SEND_CMD is set) ---
OMNIUSE_RPC_URL=https://cloudflare-eth.com
OMNIUSE_WALLET_ADDRESS=         # your 0x… address (read-only balance checks)
OMNIUSE_WALLET_CURRENCY=ETH
OMNIUSE_WALLET_MAX_TX=0.01      # HARD per-transaction cap
OMNIUSE_AUTOPAY_MIN=            # balance threshold before any payment may go out
# Command that actually signs/sends (e.g. your hardware-wallet CLI). Called as:
#   <cmd> <to> <amount> <purpose>
# OmniUse NEVER touches private keys itself. Leave empty to queue payments only.
OMNIUSE_SEND_CMD=

# --- Remote body (Hub) ---
# On the device you want to control:  OMNIUSE_HUB_TOKEN=<secret> python -m omniuse.hub
# On the AI side:                      OMNIUSE_HUB_URL=http://<device>:8787  + same token
OMNIUSE_HUB_URL=
OMNIUSE_HUB_TOKEN=
