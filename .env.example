# Copy this file to `.env` and fill in your values.
# OmniUse reads plain environment variables, so `export` also works.

# --- LLM (any OpenAI-compatible provider) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OMNIUSE_MODEL=gpt-4o-mini

# Examples:
#   Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1  OMNIUSE_MODEL=llama-3.3-70b-versatile
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1       OMNIUSE_MODEL=qwen2.5:7b

# --- Agent behaviour ---
OMNIUSE_MAX_STEPS=30
OMNIUSE_HEADLESS=1              # 0 = watch the browser work
OMNIUSE_SCREENSHOTS_DIR=screenshots
# OMNIUSE_WORKDIR=.             # cwd for system_run
